# NOMA frontend env. Copy to .env.local for local dev.

# --- API ---
# The backend lives in ../backend and listens on PORT (default 3000).
# The frontend proxies /api/* to API_ORIGIN via a rewrite (no CORS needed).
# Leave unset for local dev; set it when the API runs elsewhere (build server).
# API_ORIGIN=http://localhost:3000

# --- Chain (Robinhood Chain) ---
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_CHAIN_RPC_URL=

# --- WalletConnect (mobile wallets / QR) ---
# Free project id from https://cloud.walletconnect.com — without it only injected
# browser wallets (MetaMask/Rabby extension or in-app browser) can connect.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contracts (footer + links) ---
# NEXT_PUBLIC_NOMA_TOKEN_ADDRESS=
# NEXT_PUBLIC_NOMA_STAKING_ADDRESS=
# NEXT_PUBLIC_SAFE_ADDRESS=

# --- Explorer (tx links) ---
# NEXT_PUBLIC_EXPLORER_URL=

# --- AI gateway (docs link; the delivered key uses the backend AI_PUBLIC_BASE_URL) ---
# NEXT_PUBLIC_AI_BASE_URL=http://localhost:3101/api/ai/v1

# --- Post-launch features (OFF at launch; frontend.md §11) ---
# NEXT_PUBLIC_FEATURE_GHOST_CHECKOUT=1
# NEXT_PUBLIC_FEATURE_CAPSULES=1
# NEXT_PUBLIC_FEATURE_EXPOSURE_RECEIPT=1
# NEXT_PUBLIC_FEATURE_SUBSCRIPTION_GUARDIAN=1
