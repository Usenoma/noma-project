# Compose-level settings for docker-compose.prod.yml (copy to compose.env).
DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# space-separated CIDRs allowed to reach /admin (default: everyone, still token-protected)
ADMIN_ALLOW_CIDR=0.0.0.0/0 ::/0
POSTGRES_PASSWORD=
NOMA_VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
