{
  "name": "noma-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:workers": "tsx watch --env-file-if-exists=.env src/workers/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node --env-file-if-exists=.env dist/main.js",
    "start:workers": "node --env-file-if-exists=.env dist/workers/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "bash test/integration/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fastify/rate-limit": "^10.2.1",
    "@noble/curves": "^1.8.1",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "viem": "^2.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@scure/bip39": "^1.5.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
