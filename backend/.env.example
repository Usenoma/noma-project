NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://noma:noma@127.0.0.1:55442/noma
REDIS_URL=redis://127.0.0.1:56389

# Robinhood Chain mainnet (public RPC is rate-limited; use a dedicated provider in production)
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
PAYMENT_CONFIRMATIONS=3

# $NOMA / Pons V2
NOMA_TOKEN_ADDRESS=
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_FEE_ESCROW=
NOMA_BONDING_CURVE=
PONS_V2_MEME_HOOK=
NOMA_V4_POOL_ID=
NOMA_QUOTE_ASSET=ETH
STOCK_TOKEN_SOURCE=
# wrapped ZEC on Robinhood Chain (open decision: wrapped vs native)
ZEC_TOKEN_ADDRESS=
# $NOMA deployment block
REWARD_INDEXER_START_BLOCK=

# Payments: invoice deposit addresses are derived from this xpub (server never holds the private key)
PAYMENT_XPUB=
USDC_ADDRESS=
INVOICE_TTL_MINUTES=15
OVERPAY_REFUND_MIN_USD=0.5

# Refund hot wallet (limited float)
REFUND_PRIVATE_KEY=
REFUND_WALLET_MIN_ETH=0.02
REFUND_WALLET_MIN_USDC=100

# Deposit sweeper ONLY (npm run sweeper, separate host). Never set PAYMENT_XPRV for the API or
# workers: they refuse to start with it in production.
PAYMENT_XPRV=
TREASURY_ADDRESS=
SWEEPER_GAS_PRIVATE_KEY=
SWEEP_MIN_USD=5
SWEEP_INTERVAL_MINUTES=60

# Reward Engine Safe multisig (creator fee recipient on Pons + NomaStaking EXECUTOR).
# The proposer key is a Safe *delegate*: it can queue transactions, never sign or execute them.
SAFE_ADDRESS=
SAFE_PROPOSER_PRIVATE_KEY=
SAFE_TX_SERVICE_URL=https://api.safe.global/tx-service/robinhood
SAFE_API_KEY=

# Staking (only staked $NOMA earns rewards; durations in seconds)
NOMA_STAKING_ADDRESS=
UNSTAKE_COOLDOWN=604800
REWARD_STREAM_DURATION=604800

# Security
# 32 bytes, base64
ENCRYPTION_KEY=
ADMIN_TOKEN=

# Alert delivery (optional; without these, alerts are log lines only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
MEMECOIN_FEES_PENDING_ALERT_HOURS=48

# Agent (Claude)
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# Suppliers
ESIMACCESS_KEY=
BITREFILL_KEY=
CRYPTOREFILLS_KEY=
BITLAUNCH_KEY=
VPNRESELLERS_KEY=
IPROYAL_KEY=
OPENROUTER_PROVISIONING_KEY=
