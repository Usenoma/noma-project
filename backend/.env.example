NODE_ENV=development
PORT=3000
# 127.0.0.1 on public servers (frontend proxies /api to it over localhost); 0.0.0.0 for local dev
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://noma:noma@127.0.0.1:55442/noma
REDIS_URL=redis://127.0.0.1:56389

# Robinhood Chain mainnet (public RPC is rate-limited; use a dedicated provider in production)
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
PAYMENT_CONFIRMATIONS=3

# $NOMA / Pons V2
NOMA_TOKEN_ADDRESS=
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_FEE_ESCROW=
NOMA_BONDING_CURVE=
PONS_V2_MEME_HOOK=
NOMA_V4_POOL_ID=
NOMA_QUOTE_ASSET=ETH
STOCK_TOKEN_SOURCE=
# wrapped ZEC on Robinhood Chain (open decision: wrapped vs native)
ZEC_TOKEN_ADDRESS=
# $NOMA deployment block
REWARD_INDEXER_START_BLOCK=

# Payments: buyers pay wallet-to-wallet into this single fixed address (no per-invoice deposit
# address, no sweeper). The same wallet is used for refunds. Receives native ETH and ERC-20 USDG.
PAYMENT_ADDRESS=
# Stablecoin on Robinhood Chain (canonical USDG)
USDG_ADDRESS=
INVOICE_TTL_MINUTES=15
OVERPAY_REFUND_MIN_USD=0.5

# Supplier order still pending after this long → alert for manual handling (never auto-refunded)
FULFILLMENT_PENDING_ALERT_MINUTES=60

# Refund hot wallet (limited float)
REFUND_PRIVATE_KEY=
# 1 = automatically refund late/underpaid/failed orders; 0 = hold funds for manual admin refund
REFUNDS_AUTO_ENABLED=1
REFUND_WALLET_MIN_ETH=0.02
REFUND_WALLET_MIN_USDC=100

# Reward Engine Safe multisig (creator fee recipient on Pons + NomaStaking EXECUTOR).
# The proposer key is a Safe *delegate*: it can queue transactions, never sign or execute them.
SAFE_ADDRESS=
SAFE_PROPOSER_PRIVATE_KEY=
SAFE_TX_SERVICE_URL=https://api.safe.global/tx-service/robinhood
SAFE_API_KEY=

# Staking (only staked $NOMA earns rewards; durations in seconds)
NOMA_STAKING_ADDRESS=
UNSTAKE_COOLDOWN=604800
REWARD_STREAM_DURATION=604800

# Security
# 32 bytes, base64
ENCRYPTION_KEY=
ADMIN_TOKEN=
# read-only wallet session lifetime for the buyer order vault (minutes)
WALLET_SESSION_TTL_MINUTES=60

# Alert delivery (optional; without these, alerts are log lines only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
MEMECOIN_FEES_PENDING_ALERT_HOURS=48

# Agent (MiMo via OpenRouter; LLM_API_KEY falls back to OPENROUTER_API_KEY)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=xiaomi/mimo-v2.6-flash

# AI gateway (NOMA-issued keys; the OpenRouter key never leaves the backend)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openai/gpt-4o-mini
AI_PUBLIC_BASE_URL=http://localhost:3101/api/ai/v1
AI_KEY_TTL_DAYS=365
AI_MAX_TOKENS=4096
AI_RESERVE_SAFETY=1.15
# Reserved AI usage older than this is released by the worker (crashed/aborted request).
AI_RESERVATION_TIMEOUT_MINUTES=30

# Ghost Agent: privacy-first research missions. Search runs through Tavily when a key is set,
# otherwise keyless DuckDuckGo; page fetches are server-side, stateless and SSRF-guarded.
# Real PII is never stored — profiles hold aliases only.
TAVILY_API_KEY=
# Ghost missions route through OpenRouter by default (the MiMo-direct endpoint flags
# privacy-focused prompts as "high risk"). Override per deployment if needed.
GHOST_LLM_API_KEY=
GHOST_LLM_BASE_URL=
GHOST_LLM_MODEL=
GHOST_MAX_SEARCH_RESULTS=5
GHOST_FETCH_TIMEOUT_MS=15000
GHOST_FETCH_MAX_BYTES=200000
GHOST_FETCH_MAX_CHARS=12000
GHOST_MAX_TOOL_TURNS=12

# Public base URL of this API, e.g. https://api.example.com (optional: enables supplier webhooks,
# which only speed up fulfillment; GET /admin/webhooks lists the URLs to register)
PUBLIC_API_URL=

# Suppliers
ESIMACCESS_KEY=
BITREFILL_KEY=
BITLAUNCH_KEY=
VPNRESELLERS_KEY=
# $ per active VPN account per month (VPNresellers has no price API; pricing page tier 1-999 accounts)
VPNRESELLERS_MONTHLY_USD=1.99
IPROYAL_KEY=

# Post-launch features (OFF at launch). See frontend.md §11 / backend.md §15.
# While unset/empty the routes answer "not enabled"; nothing at launch depends on them.
FEATURE_GHOST_CHECKOUT=
FEATURE_CAPSULES=
FEATURE_SUBSCRIPTION_GUARDIAN=
FEATURE_GHOST_AGENT=
